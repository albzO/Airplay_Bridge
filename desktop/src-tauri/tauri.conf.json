{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirPlay Bridge",
  "version": "0.1.0",
  "identifier": "com.airplaywin.bridge",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "AirPlay Bridge", "width": 1080, "height": 760, "minWidth": 780, "minHeight": 600, "decorations": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
