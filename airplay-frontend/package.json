{
  "name": "airplay-bridge-ui",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test:protocol": "node --test ../test/frontend/protocol.test.mjs",
    "test:diagnostics": "node --test ../test/frontend/diagnostics.test.mjs",
    "test:session": "node --test ../test/frontend/session.test.mjs",
    "test:dom": "playwright test --config ../test/frontend/playwright.config.mjs",
    "test:ui": "vite --config ../test/frontend/vite.config.mjs",
    "test:ui:build": "vite build --config ../test/frontend/vite.config.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-vue": "^6",
    "prettier": "3.6.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7",
    "vue-tsc": "^3"
  }
}
